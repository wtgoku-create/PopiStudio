@@ -0,0 +1,59 @@
+type ActiveCronRunAbortRegistration = {
+  jobId: string;
+  controller: AbortController;
+};
+
+const activeCronRunAbortControllersByJobId = new Map<string, Set<AbortController>>();
+
+function normalizeCronJobId(jobId: string | undefined): string {
+  return jobId?.trim() ?? "";
+}
+
+export function registerActiveCronRunAbortController(
+  registration: ActiveCronRunAbortRegistration,
+): () => void {
+  const jobId = normalizeCronJobId(registration.jobId);
+  if (!jobId) {
+    return () => {};
+  }
+  let controllers = activeCronRunAbortControllersByJobId.get(jobId);
+  if (!controllers) {
+    controllers = new Set();
+    activeCronRunAbortControllersByJobId.set(jobId, controllers);
+  }
+  controllers.add(registration.controller);
+  return () => {
+    const currentControllers = activeCronRunAbortControllersByJobId.get(jobId);
+    if (!currentControllers) {
+      return;
+    }
+    currentControllers.delete(registration.controller);
+    if (currentControllers.size === 0) {
+      activeCronRunAbortControllersByJobId.delete(jobId);
+    }
+  };
+}
+
+export function cancelActiveCronRunByJobId(params: {
+  jobId: string | undefined;
+  reason?: string;
+}): { found: boolean; cancelled: boolean } {
+  const jobId = normalizeCronJobId(params.jobId);
+  if (!jobId) {
+    return { found: false, cancelled: false };
+  }
+  const controllers = activeCronRunAbortControllersByJobId.get(jobId);
+  if (!controllers || controllers.size === 0) {
+    return { found: false, cancelled: false };
+  }
+  const reason = params.reason?.trim() || "Cron run cancelled by operator.";
+  let cancelled = false;
+  for (const controller of controllers) {
+    if (controller.signal.aborted) {
+      continue;
+    }
+    controller.abort(reason);
+    cancelled = true;
+  }
+  return { found: true, cancelled };
+}
